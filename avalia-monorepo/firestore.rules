rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Funções auxiliares ──────────────────────────────────────────────────

    // Usuário autenticado (qualquer método, incluindo anônimo)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Usuário com email verificado (Google Login)
    function isEmailUser() {
      return isAuthenticated()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    // Admin: email verificado E pertence ao domínio autorizado
    // Adapte a lista de emails ou domínio conforme necessário.
    function isAdmin() {
      return isEmailUser();
    }

    // ─── Coleção: auth ───────────────────────────────────────────────────────
    // Documentos de configuração (secret_code, admin_model_*, etc.)
    // Leitura pública (necessário para o login por código de acesso funcionar).
    // Escrita restrita ao admin autenticado via Google.
    match /auth/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Coleção: admins ─────────────────────────────────────────────────────
    // Proteção de nível de produção: impede enumeração. Apenas o próprio admin lê seu documento por UID ou E-mail
    match /admins/{adminId} {
      allow read: if isAuthenticated() && (request.auth.uid == adminId || request.auth.token.email == adminId);
      allow write: if isAdmin();
    }

    // ─── Coleção: telemetry_logs ─────────────────────────────────────────────
    // Logs de uso e erros gerados pelo app (inclui sessões anônimas de visitantes)
    match /telemetry_logs/{logId} {
      allow create: if isAuthenticated() && request.resource.data.keys().hasAny(['isoDate', 'eventType', 'appName']);
      allow read:   if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ─── Coleção: generated_quizzes ──────────────────────────────────────────
    // Quizzes gerados e salvos (leitura pública para keywords e criação para autenticados/anônimos)
    match /generated_quizzes/{quizId} {
      allow read:          if true;
      allow create:        if isAuthenticated() && request.resource.data.keys().hasAny(['title', 'questions', 'appName']);
      allow update, delete: if isAdmin();
    }

    // ─── Bloqueio padrão ─────────────────────────────────────────────────────
    // Qualquer coleção não listada acima é completamente bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
