rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Funções auxiliares ──────────────────────────────────────────────────

    // Usuário autenticado (qualquer método, incluindo anônimo)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Usuário com email verificado (Google Login)
    function isEmailUser() {
      return isAuthenticated()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    // Admin: email verificado E pertence ao domínio autorizado
    // Adapte a lista de emails ou domínio conforme necessário.
    function isAdmin() {
      return isEmailUser();
    }

    // ─── Coleção: auth ───────────────────────────────────────────────────────
    // O documento 'auth/config' armazena apenas o PIN (secret_code) e identificadores de modelos.
    // As chaves de API privadas (admin_key_*) foram removidas deste documento e movidas para o Secret Manager.
    match /auth/config {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /auth/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Coleção: telemetry_brute_force_locks ────────────────────────────────
    // Controle de força bruta exclusivo do servidor (Admin SDK). Bloqueio total client-side.
    match /telemetry_brute_force_locks/{document=**} {
      allow read, write: if false;
    }

    // ─── Coleção: admins ─────────────────────────────────────────────────────
    // Proteção de nível de produção: impede enumeração. Apenas o próprio admin lê seu documento por UID ou E-mail
    match /admins/{adminId} {
      allow read: if isAuthenticated() && (request.auth.uid == adminId || request.auth.token.email == adminId);
      allow write: if isAdmin();
    }

    // ─── Coleção: telemetry_logs ─────────────────────────────────────────────
    // Logs de uso e erros gerados pelo app (inclui sessões anônimas de visitantes)
    match /telemetry_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // ─── Coleção: generated_quizzes ──────────────────────────────────────────
    // Quizzes gerados e salvos (leitura pública para keywords e criação para autenticados/anônimos)
    match /generated_quizzes/{quizId} {
      allow read:          if true;
      allow write:         if request.auth != null;
    }

    // ─── Bloqueio padrão ─────────────────────────────────────────────────────
    // Qualquer coleção não listada acima é completamente bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
