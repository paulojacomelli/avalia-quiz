{
    "name": "avalia-monorepo",
    "version": "1.9.69",
    "private": true,
    "license": "GPL-3.0-only",
    "workspaces": [
        "packages/*",
        "apps/*",
        "apps/*/*",
        "functions"
    ],
    "scripts": {
        "build": "turbo run build",
        "build:generic": "turbo run build --filter=@avalia/quiz",
        "build:jw": "turbo run build --filter=@avalia/jw-quiz",
        "build:kids": "turbo run build --filter=@avalia/kids",
        "deploy:generic": "npm run build:generic && firebase deploy --only hosting:generic",
        "deploy:jw": "npm run build:jw && firebase deploy --only hosting:jw",
        "dev": "turbo run dev --parallel",
        "dev:generic": "turbo run dev --filter=@avalia/quiz",
        "dev:jw": "turbo run dev --filter=@avalia/jw-quiz",
        "dev:kids": "turbo run dev --filter=@avalia/kids",
        "apply-official-assets": "node scripts/apply-official-assets.js",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "test:e2e": "playwright test",
        "functions:build": "npm --prefix functions run build",
        "functions:serve": "npm --prefix functions run serve",
        "functions:deploy": "npm --prefix functions run deploy",
        "functions:logs": "npm --prefix functions run logs"
    },
    "devDependencies": {
        "autoprefixer": "^10.5.0",
        "postcss": "^8.5.15",
        "tailwindcss": "^3.4.19",
        "turbo": "^1.11.3",
        "@capacitor/core": "^8.5.0",
        "@capacitor/cli": "^8.5.0",
        "@capacitor/android": "^8.5.0",
        "@capacitor/assets": "^3.0.5",
        "@playwright/test": "^1.47.0"
    }
}
