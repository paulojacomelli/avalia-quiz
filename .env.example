# ==============================================================================
# Avalia Quiz — Modelo de Variáveis de Ambiente (.env.example)
# Copie este arquivo como '.env' nos diretórios dos apps em avalia-monorepo/apps/
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase (Obrigatório para Firestore, Storage, Telemetria e Auth)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=sua_firebase_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 2. Provedores de IA (Opcionais no build, podem ser informados na UI pelo usuário)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Nativo)
GEMINI_API_KEY=

# OpenRouter (Acesso a modelos variados como Claude, Llama, Mistral)
VITE_OPENROUTER_API_KEY=

# Groq (Inferência ultra-rápida)
VITE_GROQ_API_KEY=

# DeepSeek API
VITE_DEEPSEEK_API_KEY=
